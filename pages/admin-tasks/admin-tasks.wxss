.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 顶部管理员信息与统计 */
.admin-header {
  background: linear-gradient(135deg, #2563eb, #1e40af);
  color: #ffffff;
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.2);
}

.admin-name {
  font-size: 40rpx;
  font-weight: bold;
}

.admin-role {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.8;
}

.stats-row {
  display: flex;
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

/* Tab 切换栏 */
.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  padding: 20rpx 0;
  border-radius: 12rpx;
  position: relative;
  font-weight: 500;
}

.tab.active {
  background: #2563eb;
  color: #ffffff;
  font-weight: bold;
}

/* 角标 */
.badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  background: #fa5151;
  color: #ffffff;
  font-size: 20rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 50%;
  text-align: center;
}

.loading,
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 任务卡片 */
.task-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-sizing: border-box;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.task-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
}

.pending-tag {
  font-size: 24rpx;
  color: #f59e0b;
}

.tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-approved {
  color: #07c160;
  background: #f6ffed;
}

.tag-rejected {
  color: #fa5151;
  background: #fff1f0;
}

.task-info {
  font-size: 27rpx;
  color: #4b5563;
  margin-bottom: 16rpx;
}

.score {
  font-size: 30rpx;
  font-weight: bold;
}

.step {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eeeeee;
  font-size: 25rpx;
  color: #2563eb;
}

.comment-section {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.comment-input {
  width: 100%;
  min-height: 100rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.action-buttons {
  display: flex;
  margin-top: 30rpx;
  gap: 20rpx;
}

.action-buttons button {
  flex: 1;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.approve-btn {
  background-color: #07c160;
  color: white;
}

.reject-btn {
  background-color: #fa5151;
  color: white;
}

.detail-btn {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
}