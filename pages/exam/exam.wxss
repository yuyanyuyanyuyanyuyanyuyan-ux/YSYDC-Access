.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 30rpx;
  box-sizing: border-box;
}

.exam-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.timer {
  font-size: 26rpx;
  color: #666;
}

.timer text {
  color: #e64340;
  font-size: 34rpx;
  font-weight: bold;
  margin-left: 10rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #e5e5e5;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 50rpx;
}

.progress-inner {
  height: 100%;
  background: #1677ff;
  border-radius: 10rpx;
  transition: width 0.3s;
}

.question-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.question-number {
  font-size: 34rpx;
  font-weight: bold;
  color: #1677ff;
  margin-bottom: 20rpx;
}

.question-title {
  font-size: 34rpx;
  line-height: 1.6;
  color: #222;
}

.options {
  margin-top: 20rpx;
}

.option {
  background: #ffffff;
  border: 2rpx solid #eeeeee;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;

  font-size: 30rpx;
  color: #333;

  transition: all 0.2s;
}

.option:active {
  opacity: 0.8;
}

.selected {
  border-color: #1677ff;
  background: #f0f6ff;
  color: #1677ff;
  font-weight: 600;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 50rpx;
}

.actions button {
  flex: 1;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.secondary-button {
  background: #ffffff;
  border: 1rpx solid #dddddd;
  color: #333;
}

.primary-button {
  background: #1677ff;
  color: #ffffff;
}

.submit-button {
  background: #07c160;
  color: #ffffff;
}

.answer-info {
  margin-top: 30rpx;
  text-align: center;
  color: #888;
  font-size: 26rpx;
}