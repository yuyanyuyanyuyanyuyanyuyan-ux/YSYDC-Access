<view class="page">

<view class="header">
  <view class="title">管理员登录</view>
  <view class="subtitle">数据中心访问审批系统</view>
</view>

<view class="login-card">

  <view class="form-item">
    <text class="label">管理员账号</text>

    <input
      placeholder="请输入管理员账号"
      value="{{username}}"
      bindinput="inputUsername"
    />
  </view>


  <view class="form-item">
    <text class="label">管理员密码</text>

    <input
      placeholder="请输入管理员密码"
      password
      value="{{password}}"
      bindinput="inputPassword"
    />
  </view>


  <button
    class="login-button"
    bindtap="login"
    loading="{{loading}}"
  >
    登录
  </button>

</view>

</view>