<view class="page">

  <view class="header">
    <view class="title">填写工单</view>
  </view>

  <view class="form">

    <!-- 按字段定义动态渲染 -->
    <block wx:for="{{fields}}" wx:key="field_key" wx:for-item="f">
      <view class="field">
        <view class="label">{{f.field_name}}<text wx:if="{{f.required}}" class="required">*</text></view>

        <!-- 单行文本 -->
        <input
          wx:if="{{f.input_type === 'text'}}"
          class="input"
          placeholder="请输入{{f.field_name}}"
          value="{{formValues[f.field_key]}}"
          data-key="{{f.field_key}}"
          bindinput="onTextInput"
        />

        <!-- 多行文本 -->
        <textarea
          wx:elif="{{f.input_type === 'textarea'}}"
          class="textarea"
          placeholder="请输入{{f.field_name}}"
          value="{{formValues[f.field_key]}}"
          data-key="{{f.field_key}}"
          bindinput="onTextInput"
        ></textarea>

        <!-- 选择框 -->
        <picker
          wx:elif="{{f.input_type === 'select'}}"
          mode="selector"
          range="{{f.options}}"
          value="{{selectIndex[f.field_key]}}"
          data-key="{{f.field_key}}"
          bindchange="onSelectChange"
        >
          <view class="picker">{{formValues[f.field_key] || '请选择' + f.field_name}}</view>
        </picker>

        <!-- 日期 -->
        <picker
          wx:elif="{{f.input_type === 'date'}}"
          mode="date"
          value="{{formValues[f.field_key]}}"
          data-key="{{f.field_key}}"
          bindchange="onDateChange"
        >
          <view class="picker">{{formValues[f.field_key] || '选择日期'}}</view>
        </picker>

        <!-- 时间 -->
        <picker
          wx:elif="{{f.input_type === 'time'}}"
          mode="time"
          value="{{formValues[f.field_key]}}"
          data-key="{{f.field_key}}"
          bindchange="onTimeChange"
        >
          <view class="picker">{{formValues[f.field_key] || '选择时间'}}</view>
        </picker>

        <!-- 日期时间（日期 + 时间组合） -->
        <view wx:elif="{{f.input_type === 'datetime'}}" class="time-row">
          <picker mode="date" value="{{dtDate[f.field_key]}}" data-key="{{f.field_key}}" data-part="date" bindchange="onDateTimeChange">
            <view class="picker">{{dtDate[f.field_key] || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{dtTime[f.field_key]}}" data-key="{{f.field_key}}" data-part="time" bindchange="onDateTimeChange">
            <view class="picker">{{dtTime[f.field_key] || '选择时间'}}</view>
          </picker>
        </view>

        <!-- 来访人员（多人列表） -->
        <block wx:elif="{{f.input_type === 'visitors'}}">
          <view wx:for="{{visitors}}" wx:key="index" class="visitor-item">
            <view class="visitor-row">
              <input class="input half" placeholder="姓名（必填）" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onVisitorInput" />
              <input class="input half" placeholder="身份证号（必填）" value="{{item.id_card}}" data-index="{{index}}" data-field="id_card" bindinput="onVisitorInput" />
            </view>
            <view class="visitor-row">
              <input class="input half" placeholder="电话" type="number" maxlength="11" value="{{item.phone}}" data-index="{{index}}" data-field="phone" bindinput="onVisitorInput" />
              <input class="input half" placeholder="单位" value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="onVisitorInput" />
            </view>
            <view class="visitor-del" data-index="{{index}}" bindtap="removeVisitor">删除此人</view>
          </view>
          <view class="add-btn" bindtap="addVisitor">+ 添加人员</view>
        </block>

      </view>
    </block>

  </view>

  <view class="actions">
    <button class="btn draft" bindtap="saveDraft">存草稿</button>
    <button class="btn submit" bindtap="submit">提交工单</button>
  </view>

</view>
