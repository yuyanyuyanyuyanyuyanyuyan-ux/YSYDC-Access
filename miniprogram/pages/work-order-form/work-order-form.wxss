.page {
  padding: 40rpx;
}
.header {
  margin-bottom: 40rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
}
.form {
  display: flex;
  flex-direction: column;
}
.field {
  margin-bottom: 30rpx;
}
.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.required {
  color: #dc2626;
}
.input {
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}
.btn {
  margin-top: 20rpx;
}
.primary {
  background: #1677ff;
  color: #fff;
}
