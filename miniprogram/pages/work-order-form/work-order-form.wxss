.page {
  padding: 30rpx 30rpx 60rpx;
}
.header {
  margin-bottom: 30rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
}
.form {
  display: flex;
  flex-direction: column;
}
.field {
  margin-bottom: 30rpx;
}
.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.required {
  color: #dc2626;
}
.input {
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 28rpx;
}
.textarea {
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
}
.half {
  flex: 1;
}
.visitor-item {
  border: 1rpx dashed #d0d0d0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.visitor-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.visitor-del {
  text-align: right;
  color: #dc2626;
  font-size: 26rpx;
}
.add-btn {
  text-align: center;
  color: #1677ff;
  border: 1rpx dashed #1677ff;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 28rpx;
}
.time-row {
  display: flex;
  gap: 16rpx;
}
.picker {
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 28rpx;
  color: #333;
  flex: 1;
}
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.btn {
  flex: 1;
}
.draft {
  background: #f5f5f5;
  color: #333;
}
.submit {
  background: #1677ff;
  color: #fff;
}
