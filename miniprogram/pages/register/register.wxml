<view class="page">

<!-- 页面标题 -->
<view class="header">
  <view class="title">个人信息登记</view>
  <view class="subtitle">
    请如实填写进入数据机房所需信息
  </view>
</view>


<!-- 表单卡片 -->
<view class="form-card">

  <!-- 姓名 -->
  <view class="form-item">

    <view class="label">
      姓名
      <text class="required">*</text>
    </view>

    <input
      class="input"
      placeholder="请输入姓名"
      value="{{name}}"
      bindinput="inputName"
    />

  </view>


  <!-- 手机号 -->
  <view class="form-item">

    <view class="label">
      手机号
      <text class="required">*</text>
    </view>

    <input
      class="input"
      placeholder="请输入11位手机号码"
      type="number"
      maxlength="11"
      value="{{phone}}"
      bindinput="inputPhone"
    />

  </view>


  <!-- 公司 / 单位 -->
  <view class="form-item">

    <view class="label">
      公司 / 单位
      <text class="required">*</text>
    </view>

    <input
      class="input"
      placeholder="请输入公司或单位名称"
      value="{{company}}"
      bindinput="inputCompany"
    />

  </view>


  <!-- 身份类型 -->
  <view class="form-item">

    <view class="label">
      身份类型
      <text class="required">*</text>
    </view>

    <picker
      mode="selector"
      range="{{identityTypes}}"
      bindchange="identityChange"
    >

      <view class="select-box">

        <text class="{{identityType ? 'selected' : 'placeholder'}}">
          {{identityType || "请选择身份类型"}}
        </text>

        <text class="arrow">⌄</text>

      </view>

    </picker>

  </view>


  <!-- 访问目的 -->
  <view class="form-item">

    <view class="label">
      访问目的
      <text class="required">*</text>
    </view>

    <textarea
      class="textarea"
      placeholder="请简要说明进入数据机房的目的"
      value="{{purpose}}"
      maxlength="100"
      bindinput="inputPurpose"
    />

    <view class="text-count">
      {{purpose.length}} / 100
    </view>

  </view>

</view>


<!-- 下一步按钮 -->
<button
  class="next-button"
  bindtap="submitForm"
>
  下一步
</button>


<!-- 底部提示 -->
<view class="notice">
  <text>请确保所填写的信息真实有效</text>
</view>

</view>