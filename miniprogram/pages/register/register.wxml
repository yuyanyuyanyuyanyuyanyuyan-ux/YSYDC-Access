<view class="page">

  <view class="header">
    <view class="title">访客注册</view>
    <view class="subtitle">请填写信息，系统将按身份证号匹配已审批的工单</view>
  </view>

  <view class="form-card">

    <view class="form-item">
      <view class="label">姓名<text class="required">*</text></view>
      <input class="input" placeholder="请输入姓名" value="{{name}}" bindinput="inputName" />
    </view>

    <view class="form-item">
      <view class="label">身份证号<text class="required">*</text></view>
      <input class="input" placeholder="请输入身份证号（用于匹配工单）" value="{{id_card}}" bindinput="inputIdCard" />
    </view>

    <view class="form-item">
      <view class="label">手机号<text class="required">*</text></view>
      <input class="input" placeholder="请输入11位手机号码" type="number" maxlength="11" value="{{phone}}" bindinput="inputPhone" />
    </view>

    <view class="form-item">
      <view class="label">密码<text class="required">*</text></view>
      <input class="input" placeholder="请设置密码（至少6位）" password value="{{password}}" bindinput="inputPassword" />
    </view>

    <view class="form-item">
      <view class="label">公司 / 单位</view>
      <input class="input" placeholder="请输入公司或单位名称（选填）" value="{{company}}" bindinput="inputCompany" />
    </view>

  </view>

  <button class="next-button" bindtap="submitForm">注册</button>

  <view class="notice">
    <text>身份证号需与业务部提交工单中的来访人员一致</text>
  </view>

</view>
