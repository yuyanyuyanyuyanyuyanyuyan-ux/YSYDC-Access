/* 整个页面 */

.page {
  min-height: 100vh;
  background-color: #f5f6f8;
  padding: 40rpx 30rpx 60rpx;
  box-sizing: border-box;
}


/* 标题区域 */

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1f2937;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #909399;
}


/* 表单卡片 */

.form-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  box-sizing: border-box;
}


/* 每一个表单项 */

.form-item {
  margin-bottom: 36rpx;
}


/* 标签 */

.label {
  font-size: 30rpx;
  font-weight: 500;
  color: #303133;
  margin-bottom: 16rpx;
}


/* 必填星号 */

.required {
  color: #e34d59;
  margin-left: 6rpx;
}


/* 输入框 */

.input {
  width: 100%;
  height: 84rpx;

  padding: 0 24rpx;

  box-sizing: border-box;

  background-color: #f8f9fb;

  border: 1rpx solid #dcdfe6;

  border-radius: 12rpx;

  font-size: 28rpx;
}


/* 身份类型选择框 */

.select-box {
  width: 100%;
  height: 84rpx;

  padding: 0 24rpx;

  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background-color: #f8f9fb;

  border: 1rpx solid #dcdfe6;

  border-radius: 12rpx;

  font-size: 28rpx;
}


/* 未选择时 */

.placeholder {
  color: #a8abb2;
}


/* 已选择 */

.selected {
  color: #303133;
}


/* 下拉箭头 */

.arrow {
  font-size: 36rpx;
  color: #909399;
}


/* 访问目的 */

.textarea {
  width: 100%;
  height: 180rpx;

  padding: 20rpx 24rpx;

  box-sizing: border-box;

  background-color: #f8f9fb;

  border: 1rpx solid #dcdfe6;

  border-radius: 12rpx;

  font-size: 28rpx;
}


/* 字数 */

.text-count {
  text-align: right;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #909399;
}


/* 下一步按钮 */

.next-button {
  width: 100%;

  height: 90rpx;

  margin-top: 40rpx;

  border-radius: 12rpx;

  font-size: 32rpx;

  font-weight: 500;

  color: #ffffff;

  background-color: #1677ff;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* 按钮点击效果 */

.next-button::after {
  border: none;
}


/* 底部提示 */

.notice {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8abb2;
}