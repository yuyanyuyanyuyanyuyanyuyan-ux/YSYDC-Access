.page {
  padding: 30rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.item-badge {
  display: inline-block;
  background: #ecfdf5;
  color: #16a34a;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}
.item-company {
  font-size: 32rpx;
  font-weight: bold;
}
.item-row {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
}
