<view class="page">

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="item-badge">准入凭证</view>
      <view class="item-company">{{item.company}}</view>
      <view class="item-row">进入时间：{{item.entry_time}}</view>
      <view class="item-row">陪同人员：{{item.accompanying_person}}</view>
      <view class="item-row">考试成绩：{{item.score}} 分</view>
      <view class="item-row">发证时间：{{item.issued_at}}</view>
    </view>
    <view wx:if="{{!list.length}}" class="empty">暂无凭证</view>
  </view>

</view>
