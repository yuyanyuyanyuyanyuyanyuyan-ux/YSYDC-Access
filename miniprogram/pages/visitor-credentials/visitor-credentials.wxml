<view class="page">

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="item-badge">准入凭证</view>
      <!-- 工单字段（跟随工单结构动态展示） -->
      <block wx:for="{{item.display_fields}}" wx:key="field_key" wx:for-item="f">
        <view class="item-row" wx:if="{{f.input_type !== 'visitors'}}">{{f.field_name}}：{{f.value || '—'}}</view>
        <view class="item-row" wx:else>{{f.field_name}}：{{f.value.length}} 人</view>
      </block>
      <view class="item-row">考试成绩：{{item.score}} 分</view>
      <view class="item-row">发证时间：{{item.issued_at}}</view>
    </view>
    <view wx:if="{{!list.length}}" class="empty">暂无凭证</view>
  </view>

</view>
