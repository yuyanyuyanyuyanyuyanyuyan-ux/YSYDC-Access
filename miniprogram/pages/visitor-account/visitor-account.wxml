<view class="page">

  <view wx:if="{{info}}" class="card">
    <view class="row"><text class="label">姓名</text><text>{{info.name}}</text></view>
    <view class="row"><text class="label">手机号</text><text>{{info.phone}}</text></view>
    <view class="row"><text class="label">公司</text><text>{{info.company}}</text></view>
  </view>

  <view wx:else class="empty">加载中...</view>

  <button class="btn" bindtap="logout">退出登录</button>

</view>
