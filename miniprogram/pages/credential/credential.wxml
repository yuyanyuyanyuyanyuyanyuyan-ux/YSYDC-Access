<view class="page">

  <view wx:if="{{credential}}" class="card">
    <view class="status">准入通过</view>
    <view class="row"><text class="label">姓名</text><text>{{credential.name}}</text></view>
    <view class="row"><text class="label">手机号</text><text>{{credential.phone}}</text></view>
    <!-- 工单字段（跟随工单结构动态展示） -->
    <block wx:for="{{credential.display_fields}}" wx:key="field_key" wx:for-item="f">
      <view wx:if="{{f.input_type === 'visitors'}}" class="row">
        <text class="label">{{f.field_name}}</text>
        <text>{{f.value.length}} 人</text>
      </view>
      <view wx:else class="row">
        <text class="label">{{f.field_name}}</text>
        <text>{{f.value || '—'}}</text>
      </view>
    </block>
    <view class="row"><text class="label">考试成绩</text><text>{{credential.score}} 分</text></view>
    <view class="row"><text class="label">发证时间</text><text>{{credential.issued_at}}</text></view>
  </view>

  <view wx:else class="empty">暂无准入凭证</view>

  <button class="btn" bindtap="goHome">返回首页</button>

</view>
