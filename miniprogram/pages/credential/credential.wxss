.page {
  padding: 40rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.status {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #16a34a;
  margin-bottom: 40rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.label {
  color: #999;
}
.empty {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
}
.btn {
  margin-top: 60rpx;
}
