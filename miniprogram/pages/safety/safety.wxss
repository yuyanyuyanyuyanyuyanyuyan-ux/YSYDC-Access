.page {
  min-height: 100vh;
  background-color: #f5f6f8;
  padding: 40rpx 30rpx 60rpx;
  box-sizing: border-box;
}


/* 标题 */

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1f2937;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #909399;
}


/* 安全须知卡片 */

.notice-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  box-sizing: border-box;
}


/* 每一项 */

.notice-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.notice-item:last-child {
  border-bottom: none;
}


/* 编号 */

.number {
  width: 46rpx;
  height: 46rpx;

  border-radius: 50%;

  background-color: #1677ff;
  color: #ffffff;

  font-size: 24rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  margin-right: 20rpx;
}


/* 内容 */

.content {
  flex: 1;
}


/* 标题 */

.notice-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #303133;
}


/* 说明 */

.notice-text {
  margin-top: 12rpx;

  font-size: 25rpx;

  line-height: 1.6;

  color: #606266;
}


/* 阅读确认 */

.confirm-area {
  margin-top: 35rpx;
  padding: 30rpx;

  background-color: #ffffff;

  border-radius: 16rpx;
}


.checkbox-label {
  display: flex;
  align-items: center;

  font-size: 27rpx;
  color: #303133;
}


/* 按钮 */

.next-button {
  width: 100%;

  height: 90rpx;

  margin-top: 40rpx;

  background-color: #1677ff;

  color: #ffffff;

  border-radius: 12rpx;

  font-size: 32rpx;

  font-weight: 500;

  display: flex;
  align-items: center;
  justify-content: center;
}


.next-button[disabled] {
  background-color: #c9cdd4;
  color: #ffffff;
}


.next-button::after {
  border: none;
}