<view class="page">

  <view class="header">
    <view class="title">业务部成员登录</view>
  </view>

  <view class="form">
    <input class="input" placeholder="账号" value="{{username}}" bindinput="inputUsername" />
    <input class="input" placeholder="密码" password value="{{password}}" bindinput="inputPassword" />
    <button class="btn primary" bindtap="login">登录</button>
    <view class="link" bindtap="goRegister">还没有账号？去注册</view>
  </view>

</view>
