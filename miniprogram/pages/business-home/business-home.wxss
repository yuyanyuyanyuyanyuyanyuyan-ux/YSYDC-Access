.page {
  padding: 40rpx;
}
.header {
  margin-bottom: 40rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
}
.subtitle {
  color: #999;
  margin-top: 10rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.item-company {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.item-row {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}
.item-status {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.item-status.approved {
  background: #ecfdf5;
  color: #16a34a;
}
.item-status.rejected {
  background: #fef2f2;
  color: #dc2626;
}
.item-status.pending {
  background: #fffbeb;
  color: #d97706;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
.btn {
  margin-top: 40rpx;
}
.primary {
  background: #1677ff;
  color: #fff;
}
