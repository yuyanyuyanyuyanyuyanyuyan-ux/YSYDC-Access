.page {
  padding: 40rpx;
}
.hero {
  text-align: center;
  padding: 60rpx 0;
}
.greeting {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: bold;
}
.hero-desc {
  color: #999;
  margin-top: 20rpx;
}
.exam-card {
  background: #1677ff;
  color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-top: 40rpx;
}
.exam-title {
  font-size: 36rpx;
  font-weight: bold;
}
.exam-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}
.exam-btn {
  margin-top: 30rpx;
  text-align: right;
  font-size: 28rpx;
}
